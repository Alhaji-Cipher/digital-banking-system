# Railway Database Configuration
# This file helps Railway automatically configure your MySQL database

# Database
DB_HOST=${{ Mysql.MYSQL_HOST }}
DB_PORT=${{ Mysql.MYSQL_PORT }}
DB_USERNAME=${{ Mysql.MYSQL_USER }}
DB_PASSWORD=${{ Mysql.MYSQL_PASSWORD }}
DB_NAME=${{ Mysql.MYSQL_DB }}

# Application
NODE_ENV=production
PORT=3000

# JWT Configuration
JWT_SECRET=${{ SECRET_JWT_SECRET }}
JWT_EXPIRATION=3600

# Nibss by Phoenix API
NIBSS_API_BASE_URL=https://nibssbyphoenix.onrender.com/api
NIBSS_API_KEY=${{ SECRET_NIBSS_API_KEY }}
NIBSS_BANK_CODE=${{ SECRET_NIBSS_BANK_CODE }}
NIBSS_EMAIL=${{ SECRET_NIBSS_EMAIL }}
NIBSS_BANK_NAME=${{ SECRET_NIBSS_BANK_NAME }}

# Logging
LOG_LEVEL=info
